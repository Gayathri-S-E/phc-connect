# PHC Connect backend environment. Copy to .env (never commit .env). Every Google variable is OPTIONAL:
# when unset, the matching feature answers 503 AI_NOT_CONFIGURED instead of returning fake data.
# Check what the server sees (booleans only): GET /api/v1/google/status

# ---- Core --------------------------------------------------------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@localhost:5432/smarthealth_db
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- Gemini (AI assistants) --------------------------------------------------------------------------------------
# API: "Generative Language API" (generativelanguage.googleapis.com). Key from Google AI Studio.
# Restrict the key to that API only; keep it server-side (it is sent in the x-goog-api-key header).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Speech-to-Text / Text-to-Speech / Translation (voice + Tamil/Hindi) -----------------------------------------
# APIs to enable: Cloud Speech-to-Text API, Cloud Text-to-Speech API, Cloud Translation API (Basic v2).
# Restrict this key to exactly those three APIs. Server-side only; never expose in the frontend.
GOOGLE_CLOUD_API_KEY=
# Optional per-feature switches (default true): GOOGLE_STT_ENABLED, GOOGLE_TTS_ENABLED, GOOGLE_TRANSLATE_ENABLED

# ---- Google Maps Platform (nearest facilities) -------------------------------------------------------------------
# APIs to enable: Geocoding API, Routes API (Compute Route Matrix). Use a SEPARATE key restricted to those two APIs
# (plus an IP-address restriction for your server if it has a fixed egress IP). Without it, nearest-facility still
# works using straight-line (haversine) distance and reports method=haversine_only.
GOOGLE_MAPS_API_KEY=

# ---- Service account (BigQuery now, Vertex AI later) -------------------------------------------------------------
# Create a service account with the least roles needed:
#   BigQuery Data Editor + BigQuery Job User (for the export/rollup), Vertex AI User (only if using Vertex).
# Provide EITHER a path to the JSON key file OR the inline JSON (useful on Render). Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=

# ---- BigQuery (anonymised facility-level aggregates; no patient data leaves the system) --------------------------
# API to enable: BigQuery API. The dataset and table are created automatically if missing.
# Note: streaming inserts (tabledata.insertAll) need a billing-enabled project (not the free sandbox).
BIGQUERY_DATASET=
BIGQUERY_TABLE=facility_daily_aggregates
BIGQUERY_LOCATION=asia-south1

# ---- Vertex AI forecasting (optional; read by app/services/vertex_forecast.py) -----------------------------------
# API to enable: Vertex AI API. Uses the service account above. FORECAST_BACKEND=local keeps the statistical model.
# NOTE: the code currently reads VERTEX_PROJECT / VERTEX_LOCATION / VERTEX_ENDPOINT_ID (not VERTEX_FORECAST_*).
FORECAST_BACKEND=local
VERTEX_PROJECT=
VERTEX_LOCATION=asia-south1
VERTEX_ENDPOINT_ID=
