# Application Configuration
APP_NAME="Smart Health & Supply Chain Resilience"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database (Asyncpg)
DATABASE_URL="postgresql+asyncpg://app_user:local_dev_secret_password@localhost:5432/smarthealth_db"
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Security & JWT Credentials (GENERATE RANDOM FOR PRODUCTION)
JWT_SECRET="changethis_in_production_to_a_cryptographically_secure_256bit_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
